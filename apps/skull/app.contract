// A Halloween skull for the M5Stack Stopwatch (468 x 466 round screen): the four frames of
// scary-skull.gif, 326 x 466 on a black screen, each shown for the GIF's 250 ms. The frames
// are PNGs in assets/, split from the GIF and scaled to the drawn size, with the GIF's
// near-black background made black.
component Skull
  state frame = 0
  task animate mount
    every(250, step)
  action step
    frame = frame >= 3 ? 0 : frame + 1
  view
    column testId="skull" position="relative" width=468 height=466 background-color="surface.screen"
      image (frame == 0 ? "assets/skull-00.png" : (frame == 1 ? "assets/skull-01.png" : (frame == 2 ? "assets/skull-02.png" : "assets/skull-03.png"))) position="absolute" left=71 top=0 width=326 height=466 testId="frame"
